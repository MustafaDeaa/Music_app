# من https://console.groq.com/keys — لا ترفع ملف .env لأي مستودع
GROQ_API_KEY=

# اختياري — توليد صوت بالكلمات: https://sunoapi.org/api-key
SUNO_API_KEY=

# اختياري — Runware ACE-Step API
RUNWARE_API_KEY=

# اختياري — fal.ai ACE-Step API
FAL_KEY=

# اختياري — Hugging Face Inference API لموديلات MusicGen / Stable Audio Open
HF_API_KEY=

# اختياري — سيرفر ACE-Step 1.5 المحلي. شغله بـ uv run acestep-api. مثال: http://127.0.0.1:8001
LOCAL_ACE_STEP_API_URL=
